# QuizAPI API key
# Create a local .env file in the project root and replace the value below
# with your own QuizAPI key.
#
# This key is intended for the backend proxy only.
# It should be read by the Vercel Function and must never be exposed
# to frontend code or prefixed with VITE_.
#
# Never commit your real .env file.

QUIZ_API_KEY=your_api_key_here
